# Public HTTPS tunnel base URL; no /answer or /ws suffix
PUBLIC_URL=https://YOUR-INBOUND-TUNNEL.example

# Vobiz account and inbound caller ID / DID
VOBIZ_AUTH_ID=YOUR_VOBIZ_AUTH_ID
VOBIZ_AUTH_TOKEN=YOUR_VOBIZ_AUTH_TOKEN
VOBIZ_PHONE_NUMBER=+91XXXXXXXXXX

# Vobiz media format negotiated for the stream
VOBIZ_ENCODING=audio/x-mulaw
VOBIZ_SAMPLE_RATE=8000
VOBIZ_L16_ENDIAN=be

# Sarvam realtime STT
SARVAM_API_KEY=YOUR_SARVAM_API_KEY
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_LANGUAGE=auto
SARVAM_STREAM_TYPE=fast

# OpenAI LLM
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Cartesia TTS
CARTESIA_API_KEY=YOUR_CARTESIA_API_KEY
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE_ID=YOUR_CARTESIA_VOICE_ID

# Pipecat processing sample rate
PIPELINE_SAMPLE_RATE=8000

# Conversation behavior
SYSTEM_PROMPT=You are a helpful, concise voice assistant. Speak naturally and keep phone responses brief.
DEFAULT_GREETING=Hello! This is the AI assistant. How can I help you today?
LOG_LEVEL=INFO
